---
import '../styles/global.css';
import App from '../components/App';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Weidry</title>
    <meta name="description" content="Tu entrenador personal de fuerza en español: programa de 13 semanas, modo coach, temporizador de descanso y progreso. Funciona sin conexión." />
    <meta name="theme-color" content="#F8F6FC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#150F1D" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Weidry" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="format-detection" content="telephone=no" />
    <script is:inline>
      // Aplica el tema guardado antes de pintar para evitar parpadeo.
      try {
        var t = localStorage.getItem('theme') || 'system';
        var dark = t === 'dark' || (t === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      } catch (e) {}
    </script>
  </head>
  <body>
    <App client:only="react" />
    <noscript>
      <p style="padding:1rem">Weidry necesita JavaScript activado.</p>
    </noscript>
  </body>
</html>
